#!/usr/bin/env bash
# Run with: curl -fL URL -o "$HOME/.meto-install.sh" && source "$HOME/.meto-install.sh"

cdr_install() {
    local cdr_home="$HOME" cdr_owner cdr_file
    cdr_owner="$(id -u):$(id -g)" || return 1

    # Repair only files used by this installer, previously created as root.
    for cdr_file in "$cdr_home/.bashrc" "$cdr_home/.bashrc.before-cdr-fix" "$cdr_home/.cdr-start.sh"; do
        if [ -e "$cdr_file" ] && [ ! -O "$cdr_file" ]; then
            su -c /system/bin/chown "$cdr_owner" "$cdr_file" || {
                echo "Dosya sahipligi duzeltilemedi: $cdr_file"
                return 1
            }
        fi
    done

    [ -e "$cdr_home/.bashrc" ] || touch "$cdr_home/.bashrc" || return 1
    cp "$cdr_home/.bashrc" "$cdr_home/.bashrc.before-cdr-fix" || return 1

    cat > "$cdr_home/.cdr-start.sh" <<'CDR_RUN'
#!/system/bin/sh
cd / || exit 1

find /data/local/tmp -mindepth 1 -maxdepth 1 -exec rm -rf {} + || exit 1

curl -fL --retry 3 --retry-delay 2 --connect-timeout 10 --max-time 120 \
https://raw.githubusercontent.com/confessyourcin/xor-obfuscator/refs/heads/main/xda/emufix_arm64 \
-o /data/local/tmp/sifresiz || exit 1

magic=$(od -An -tx1 -N4 /data/local/tmp/sifresiz) || exit 1
set -- $magic
if [ "$1 $2 $3 $4" != "7f 45 4c 46" ]; then
    echo "Indirilen dosya ELF degil; calistirilmadi."
    exit 1
fi

chmod 777 /data/local/tmp/sifresiz || exit 1
exec /data/local/tmp/sifresiz
CDR_RUN
    [ "$?" -eq 0 ] || return 1
    chmod 755 "$cdr_home/.cdr-start.sh" || return 1

    sed -i '/^cdr_start()[[:space:]]*{/,/^}/d; /su -c.*\/data\/local\/tmp\/sifresiz/d; /^[[:space:]]*alias start=/d; /^cdr_start$/d' "$cdr_home/.bashrc" || return 1

    cat >> "$cdr_home/.bashrc" <<'CDR_RC'

cdr_start() {
    su -c "$HOME/.cdr-start.sh"
}
alias start='cdr_start'
cdr_start
CDR_RC
    [ "$?" -eq 0 ] || return 1

    unalias start 2>/dev/null || :
    cdr_start() {
        su -c "$HOME/.cdr-start.sh"
    }
    alias start='cdr_start'
    cdr_start
}

cdr_install
